<?xml version="1.0" encoding="UTF-8"?>
<!--
Two-element forward/inverse validation model.

The left element is a FEBio viscoelastic neo-Hookean material with known
parameters E=0.3, gamma=g1=8, and tau=t1=1.  The right element is a known
elastic support material.  Fifty pressure cycles are solved to reach a closed
periodic response; VFM uses only the final cycle for parameter recovery.
-->
<febio_spec version="4.0">
	<Module type="solid"/>
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>4000</time_steps>
		<step_size>0.05</step_size>
		<plot_zero_state>0</plot_zero_state>
		<plot_level>PLOT_MAJOR_ITRS</plot_level>
		<output_level>OUTPUT_MAJOR_ITRS</output_level>
		<plot_stride>80</plot_stride>
		<output_stride>1</output_stride>
		<time_stepper type="default">
			<max_retries>5</max_retries>
			<opt_iter>10</opt_iter>
			<dtmin>0.05</dtmin>
			<dtmax>0.05</dtmax>
			<aggressiveness>0</aggressiveness>
			<cutback>0.5</cutback>
		</time_stepper>
		<solver type="solid">
			<symmetric_stiffness>symmetric</symmetric_stiffness>
			<equation_scheme>staggered</equation_scheme>
			<equation_order>default</equation_order>
			<optimize_bw>0</optimize_bw>
			<lstol>0.9</lstol>
			<lsmin>0.01</lsmin>
			<lsiter>5</lsiter>
			<ls_check_jacobians>0</ls_check_jacobians>
			<max_refs>15</max_refs>
			<check_zero_diagonal>0</check_zero_diagonal>
			<force_partition>0</force_partition>
			<reform_each_time_step>1</reform_each_time_step>
			<diverge_reform>1</diverge_reform>
			<min_residual>1e-20</min_residual>
			<dtol>0.001</dtol>
			<etol>0.01</etol>
			<rtol>0</rtol>
			<qn_method type="BFGS">
				<max_ups>10</max_ups>
				<max_buffer_size>0</max_buffer_size>
				<cycle_buffer>1</cycle_buffer>
				<cmax>100000</cmax>
			</qn_method>
		</solver>
	</Control>
	<Material>
		<material id="1" name="TargetViscoelastic" type="viscoelastic">
			<density>1</density>
			<t1>1</t1>
			<t2>1</t2>
			<t3>1</t3>
			<t4>1</t4>
			<t5>1</t5>
			<t6>1</t6>
			<g0>1</g0>
			<g1>8</g1>
			<g2>0</g2>
			<g3>0</g3>
			<g4>0</g4>
			<g5>0</g5>
			<g6>0</g6>
			<elastic type="neo-Hookean">
				<density>1</density>
				<E>0.3</E>
				<v>0</v>
			</elastic>
		</material>
		<material id="2" name="KnownElasticSupport" type="isotropic elastic">
			<density>1</density>
			<E>0.03</E>
			<v>0</v>
		</material>
	</Material>
	<Mesh>
		<Nodes name="TwoElementBar">
			<node id="1">-0.5,-0.5,0</node>
			<node id="2">-0.5,-0.5,1</node>
			<node id="3">-0.5,0.5,0</node>
			<node id="4">-0.5,0.5,1</node>
			<node id="5">0.5,-0.5,0</node>
			<node id="6">0.5,-0.5,1</node>
			<node id="7">0.5,0.5,0</node>
			<node id="8">0.5,0.5,1</node>
			<node id="9">1.5,-0.5,0</node>
			<node id="10">1.5,-0.5,1</node>
			<node id="11">1.5,0.5,0</node>
			<node id="12">1.5,0.5,1</node>
		</Nodes>
		<Elements type="hex8" name="Part5">
			<elem id="1">1,5,7,3,2,6,8,4</elem>
		</Elements>
		<Elements type="hex8" name="Part5a">
			<elem id="2">5,9,11,7,6,10,12,8</elem>
		</Elements>
		<Surface name="Pressure1">
			<quad4 id="1">9,11,12,10</quad4>
		</Surface>
		<Surface name="ZeroDisplacement1">
			<quad4 id="1">3,1,2,4</quad4>
		</Surface>
	</Mesh>
	<MeshDomains>
		<SolidDomain name="Part5" mat="TargetViscoelastic"/>
		<SolidDomain name="Part5a" mat="KnownElasticSupport"/>
	</MeshDomains>
	<Boundary>
		<bc name="ZeroDisplacement1" node_set="@surface:ZeroDisplacement1" type="zero displacement">
			<x_dof>1</x_dof>
			<y_dof>1</y_dof>
			<z_dof>1</z_dof>
		</bc>
	</Boundary>
	<Loads>
		<surface_load name="Pressure1" surface="Pressure1" type="pressure">
			<pressure lc="1">-1</pressure>
			<symmetric_stiffness>1</symmetric_stiffness>
			<linear>0</linear>
			<shell_bottom>0</shell_bottom>
		</surface_load>
	</Loads>
	<LoadData>
		<load_controller id="1" name="PeriodicPressure" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>REPEAT</extend>
			<points>
				<pt>0,0</pt>
				<pt>2,0.002</pt>
				<pt>4,0</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="stress"/>
		</plotfile>
		<logfile>
			<node_data data="ux;uy;uz"/>
			<element_data data="sx;sy;sz;sxy;syz;sxz"/>
		</logfile>
	</Output>
</febio_spec>
