<?xml version="1.0" encoding="UTF-8"?>
<febio_spec version="4.0">
  <Module type="solid"/>
  <Control>
    <analysis>STATIC</analysis><time_steps>1</time_steps><step_size>1</step_size><plot_zero_state>0</plot_zero_state><plot_level>PLOT_MAJOR_ITRS</plot_level><output_level>OUTPUT_MAJOR_ITRS</output_level><plot_stride>1</plot_stride><output_stride>1</output_stride>
    <time_stepper type="default"><max_retries>5</max_retries><opt_iter>10</opt_iter><dtmin>1</dtmin><dtmax>1</dtmax><aggressiveness>0</aggressiveness><cutback>0.5</cutback></time_stepper>
    <solver type="solid"><symmetric_stiffness>symmetric</symmetric_stiffness><equation_scheme>staggered</equation_scheme><equation_order>default</equation_order><optimize_bw>0</optimize_bw><lstol>0.9</lstol><lsmin>0.01</lsmin><lsiter>5</lsiter><ls_check_jacobians>0</ls_check_jacobians><max_refs>15</max_refs><check_zero_diagonal>0</check_zero_diagonal><force_partition>0</force_partition><reform_each_time_step>1</reform_each_time_step><diverge_reform>1</diverge_reform><min_residual>1e-20</min_residual><dtol>0.001</dtol><etol>0.01</etol><rtol>0</rtol><qn_method type="BFGS"><max_ups>10</max_ups><max_buffer_size>0</max_buffer_size><cycle_buffer>1</cycle_buffer><cmax>100000</cmax></qn_method></solver>
  </Control>
  <Material><material id="1" name="Material" type="isotropic elastic"><E>1</E><v>0</v><density>1</density></material></Material>
  <Mesh>
    <Nodes name="Nodes">
      <node id="1">0,0,0</node><node id="2">1,0,0</node><node id="3">0,1,0</node>
      <node id="4">0,0,1</node><node id="5">1,0,1</node><node id="6">0,1,1</node>
    </Nodes>
    <Elements type="penta6" name="Solid"><elem id="1">1,2,3,4,5,6</elem></Elements>
    <NodeSet name="FixedNodes">1,2,3</NodeSet>
    <Surface name="PressureFace"><quad4 id="1">2,5,6,3</quad4></Surface>
  </Mesh>
  <MeshDomains><SolidDomain name="Solid" mat="Material"/></MeshDomains>
  <Boundary><bc name="Fixed" node_set="FixedNodes" type="zero displacement"><x_dof>1</x_dof><y_dof>1</y_dof><z_dof>1</z_dof></bc></Boundary>
  <Loads><surface_load name="Pressure1" surface="PressureFace" type="pressure"><pressure lc="1">-1</pressure></surface_load></Loads>
  <LoadData><load_controller id="1" type="loadcurve"><points><pt>0,0</pt><pt>1,0</pt></points></load_controller></LoadData>
  <Output><plotfile type="febio"><var type="displacement"/><var type="stress"/></plotfile><logfile><node_data data="ux;uy;uz"/><element_data data="sx;sy;sz;sxy;syz;sxz"/></logfile></Output>
</febio_spec>
